{
  "name": "Captions Reader",
  "short_name": "Captions",
  "description": "Lector de subtítulos .srt: navega, busca y reproduce subtítulos, también sin conexión.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1D1E18",
  "theme_color": "#1D1E18",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/x-subrip": [".srt"],
        "text/plain": [".srt"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
